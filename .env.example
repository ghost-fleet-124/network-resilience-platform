# BLACKSHIELD Environment Variables
PORT=3000
NODE_ENV=development

# Database configuration
# In production, use PostgreSQL: postgresql://blackshield_user:blackshield_secure_pass@localhost:5432/blackshield_db
# For local zero-dependency instant run, SQLite file is used by default:
DATABASE_URL="file:./dev.db"

# JWT Secret for SOC Operator Session
JWT_SECRET="blackshield-critical-infra-soc-secret-key-32bytes-min"

# Controlled Load Testing Guardrails
K6_PATH="k6"
MAX_TEST_CONCURRENCY_VUS=200
MAX_TEST_DURATION_SECONDS=300
MAX_TEST_TARGET_RPS=5000
ALLOWED_TARGET_PATTERNS="^(https?:\\/\\/)?(localhost|127\\.0\\.0\\.1|::1|.*\\.internal\\.local|.*\\.defense\\.test)(:\\d+)?(\\/.*)?$"
